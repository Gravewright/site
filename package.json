{
  "name": "gravewright-site",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:media": "node scripts/check.mjs --require-media",
    "start": "node scripts/serve.mjs",
    "sync:docs": "node scripts/sync-project-docs.mjs",
    "test": "node --test scripts/*.test.mjs && npm run build && npm run check"
  }
}
